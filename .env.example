# Optional. The pipeline runs fully without it.
#
# With no key set, the decider agent replays decisions from the committed cache in
# cache/llm/, and falls back to the deterministic policy in backend/app/policy.py for
# anything not cached. Totals are identical either way — that is the point (SPEC §4.3).
#
# Set this only if you want to regenerate cached decisions or run a new seed live.
ANTHROPIC_API_KEY=
